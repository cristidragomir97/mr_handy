# Companion sources are fetched from GitHub by Docker; no local clones needed.
HANDY101_ROS_DOMAIN_ID=184
# MuJoCo desktop window by default; set true to run without a display/GPU.
HANDY101_HEADLESS=false
# Start the bundled router only if a Zenoh router is not already running locally.
HANDY101_START_ROUTER=true
# Tolerate clock corrections in the development VM (milliseconds).
HANDY101_UHLC_MAX_DELTA_MS=10000
# WSLg renderer selection; matches part of the adapter name.
HANDY101_GPU_ADAPTER=Intel
